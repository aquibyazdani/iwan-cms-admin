# Copy to .env.local for local work. Vite inlines VITE_* into the bundle at
# BUILD time, so these configure a build — they are not read at runtime, and a
# change means a rebuild.
#
# ⚠ Everything here ends up in the shipped JavaScript. Never put a secret in a
# VITE_ key.

# The CMS API this build talks to.
#   local       http://localhost:4000
#   production  https://iwan-cms-api.onrender.com
VITE_API_URL=http://localhost:4000

# The public site, for the "View the site" link in the sidebar.
VITE_SITE_URL=http://localhost:5173

# Shown as a badge beside the logo. Set it on every non-production deployment so
# nobody edits the live site believing they are on dev. Leave it empty for prod.
VITE_ENV_LABEL=dev
